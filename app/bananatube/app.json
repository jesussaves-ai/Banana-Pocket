{
        // The app's manifest: banana-ui scans /usr/share/banana/apps/*/ for one of these (a small JSON, or an
        // app.conf / a *.desktop) and shows each as a tile on the Apps shelf, so the app is seen without an entry
        // in /etc/banana/systems.conf. The keys are Library::scanApps's: id, name, maker, run (%ROM% is the marker
        // file below), ext (the marker), perf (the clock profile run-bananatube applies), and, optionally, icon
        // (a picture in this folder) and accent (the tile's colour).
        "id": "bananatube",
        "name": "YouTube",
        "maker": "Banana",
        "run": "/usr/libexec/banana/run-bananatube %ROM%",
        "ext": "app",
        "perf": "balanced",
        "accent": "#e0402f"
}
