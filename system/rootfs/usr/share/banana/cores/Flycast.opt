# Banana: Flycast's defaults for the Retroid Pocket Classic: written once into
# /data/retroarch/config/Flycast/Flycast.opt by run-dreamcast (its marker is /data/retroarch/.banana-dreamcast-1).
# A change made in RetroArch's own Core Options afterwards is kept. The values are ROCKNIX's for this SoC's
# flycast-lr: native resolution and a native texture upscale (the a613 through freedreno GLES is the bottleneck for
# Dreamcast, so rendering above the console's own 640x480 only costs frames), the fast alpha sorting, no anisotropic
# filtering, the renderer on its own thread, auto skip frame (Normal: a frame the a613 cannot draw is dropped rather
# than stalling the emulation thread, which measured as 55-60 fps and choppy sound), and a real BIOS (HLE BIOS off;
# put dc_boot.bin and dc_flash.bin in banana/bios). Delete the marker to write these again.
flycast_allow_service_buttons = "disabled"
flycast_alpha_sorting = "per-strip (fast, least accurate)"
flycast_analog_stick_deadzone = "15%"
flycast_anisotropic_filtering = "off"
flycast_auto_skip_frame = "some"
flycast_boot_to_bios = "disabled"
flycast_broadcast = "NTSC"
flycast_cable_type = "TV (Composite)"
flycast_custom_textures = "disabled"
flycast_delay_frame_swapping = "disabled"
flycast_detect_vsync_swap_interval = "disabled"
flycast_digital_triggers = "disabled"
flycast_dump_textures = "disabled"
flycast_emulate_bba = "disabled"
flycast_emulate_framebuffer = "disabled"
flycast_enable_dsp = "disabled"
flycast_enable_purupuru = "enabled"
flycast_enable_rttb = "disabled"
flycast_fog = "enabled"
flycast_force_freeplay = "enabled"
flycast_force_wince = "disabled"
flycast_frame_skipping = "disabled"
flycast_gdrom_fast_loading = "disabled"
flycast_hle_bios = "disabled"
flycast_internal_resolution = "640x480"
flycast_language = "English"
flycast_mipmapping = "enabled"
flycast_native_depth_interpolation = "disabled"
flycast_network_output = "disabled"
flycast_per_content_vmus = "disabled"
flycast_pvr2_filtering = "disabled"
flycast_region = "USA"
flycast_screen_rotation = "horizontal"
flycast_sh4clock = "200"
flycast_texture_filtering = "0"
flycast_texupscale = "1"
flycast_texupscale_max_filtered_texture_size = "256"
flycast_threaded_rendering = "enabled"
flycast_trigger_deadzone = "0%"
flycast_upnp = "enabled"
flycast_vmu_sound = "disabled"
flycast_volume_modifier_enable = "enabled"
flycast_widescreen_cheats = "disabled"
flycast_widescreen_hack = "disabled"
