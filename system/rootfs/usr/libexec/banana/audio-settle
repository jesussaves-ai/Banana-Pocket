#!/bin/sh
# audio-settle: the beat a launcher waits, after the menu released its frontend, before the game opens its own.
#
# It is normally 0. A game opens MultiMedia2 -- the frontend the menu never releases -- so an ordinary launch does
# not race the menu's teardown, and the kernel's q6apm close timing (patch 0063, `dmesg | grep -i q6apm`) shows no
# close that is slow or that fails. The one case that does race is a *fast relaunch*: if a game ended moments ago,
# its own graph may still be tearing down, and a switch written into that window is reset to off -- a frontend
# instantiated with the switch off stays unrouted (silent) for its whole life. So the launchers note when they exit
# (/run/banana/last-game-end, milliseconds of uptime) and this waits out the remainder of the cooldown below, which
# leaves an ordinary launch at 0 and only pays when a game let go a moment ago.
#
# COOLDOWN is the window a teardown can still land in. It is a script constant (not a bananad knob) because it only
# ever *reduces* a wait the launcher would otherwise take; audio_handoff_ms (bananad's, published as
# /run/banana/audio-handoff-ms) is the knob that adds to it. The menu's own reopen has its own settle (audio_menu_ms).
#   audio-settle
COOLDOWN=800

v=$(cat /run/banana/audio-handoff-ms 2>/dev/null)
case "$v" in ''|*[!0-9]*) v=0 ;; esac

end=$(cat /run/banana/last-game-end 2>/dev/null)
case "$end" in ''|*[!0-9]*) end= ;; esac
if [ -n "$end" ]; then
    now=$(awk '{printf "%d", $1 * 1000}' /proc/uptime 2>/dev/null)
    case "$now" in ''|*[!0-9]*) now= ;; esac
    if [ -n "$now" ] && [ "$now" -ge "$end" ]; then
        remain=$((COOLDOWN - (now - end)))
        [ "$remain" -gt "$v" ] && v=$remain
    fi
fi

[ "$v" -gt 0 ] && sleep "$((v / 1000)).$(printf '%03d' $((v % 1000)))"
exit 0
