#!/bin/sh
# The handheld's own USB-C port, as a USB device a computer can talk to: an NCM (USB Ethernet) gadget with a one-lease
# DHCP server, so a development machine sees a network interface and an address with nothing to configure, and reaches
# the handheld without Wi-Fi, plus an adb function (FunctionFS) the adbd daemon serves (see usb-adb), so `adb devices`
# works over the same cable. Linux and macOS match the adb interface on their own; Windows needs its own adb driver,
# because configfs f_fs exposes no OS-descriptor entry to bind WinUSB to that interface (the NCM interface does have
# one). rcS runs it in the background; it is not needed for the menu.
#
#   usb-gadget          bring it up (idempotent: a second run leaves a working gadget alone)
#   usb-gadget down     tear it down
#   usb-gadget msc off|ro|rw   the mass-storage disk off, read-only, read-write (usb-msc drives this)
#
# Settings > System > Mass storage adds a USB disk (the card's data partition) for the computer; see usb-msc for the
# read-write "transfer mode" and its /data unmount dance.
#
# The port is `dr_mode = "otg"` with `role-switch-default-mode = "peripheral"` (the device tree), so with an ordinary
# cable to a computer it is a *device*, not a host -- which is exactly this. The kernel has the gadget stack and the
# NCM/ECM/RNDIS functions built in (CONFIG_USB_GADGET, CONFIG_USB_CONFIGFS_NCM), so there is no module to load. An
# OTG adapter with a gamepad turns the port into a host instead and the kernel unbinds this gadget: replug the cable
# (or reboot) to get it back.
#
# The recipe (configfs layout, the Microsoft OS descriptor that makes Windows use its NCM driver, the fixed link and
# the address scheme) follows ROCKNIX's usbgadget script for these handhelds, which uses it the same way.

LOG=/data/banana/logs/usb-gadget.log
G=/sys/kernel/config/usb_gadget/banana
# The interface is named by the function; the address is the handheld's, the computer's is handed out by DHCP. Both in
# 169.254.0.0/16 so the computer needs no particular subnet, and .1/.2 so the two ends cannot collide with a lease pool.
IFACE=usb0
ADDR=169.254.170.2
HOSTADDR=169.254.170.1
CONF=/run/banana/udhcpd-usb.conf

# Mass storage (Settings > System > Mass storage): the card's data partition (p4, exFAT) as a USB disk for the
# computer. This script makes the function; the /data dance for read-write is usb-msc's. At boot the disk is ALWAYS
# read-only -- a read-write host against a mounted /data is corruption -- and only usb-msc turns it read-write, after
# it has stopped the menu and unmounted /data. The setting is read from settings.conf, which the toggle writes.
DISK=$(cat /run/banana/disk 2>/dev/null || echo /dev/mmcblk0)
MSC_MODE=$(sed -n 's/^ *usb_mass_storage *= *\([a-z]*\).*/\1/p' /data/banana/settings.conf 2>/dev/null | tail -n 1)

# say <text>: one line to the log, which is on the card (the rootfs is read-only)
say() {
    [ -d "${LOG%/*}" ] || mkdir -p "${LOG%/*}" 2>/dev/null
    echo "usb-gadget: $*" >> "$LOG" 2>/dev/null
}

# one at a time: rcS runs this, and bananad runs it again on the UDC netlink event, and two runs at once tear each
# other's gadget down (the exists-check is not atomic, and this now waits for the adb function to be ready). Wait
# briefly for the other run rather than leaving a `msc`/`down` request unserved, and never report success for one we
# did not do. Children must NOT inherit fd 8 (the `8>&-` on the adbd/udhcpd spawns below): a long-lived child with the
# lock fd would keep the lock for the whole session and every later run would bail out ("another usb-gadget is
# running") -- which silently broke `usb-gadget msc`.
mkdir -p /run/banana 2>/dev/null
exec 8>/run/banana/usb-gadget.lock 2>/dev/null
i=0
while ! flock -n 8 2>/dev/null; do
    i=$((i + 1))
    if [ $i -ge 50 ]; then say "another usb-gadget is running; giving up"; exit 1; fi
    sleep 0.1
done

down() {
    if [ "$(cat $G/UDC 2>/dev/null)" ]; then
        echo "" > $G/UDC 2>/dev/null
    fi
    # the interface can outlive a failed unbind; do not leave its addresses or a live DHCP server behind
    ip address flush dev $IFACE 2>/dev/null
    ip link set $IFACE down 2>/dev/null
    pkill -f '/usr/libexec/banana/usb-adb up' 2>/dev/null
    pkill -f '/usr/bin/adbd' 2>/dev/null
    # BusyBox's udhcpd writes no pid file (it ignores the conf's `pidfile` line), so find it by its config instead
    pkill -f /run/banana/udhcpd-usb.conf 2>/dev/null
    rm -f $CONF
    # configfs refuses to remove a function while it is still linked into a configuration
    rm -f $G/configs/c.1/ncm.usb0
    rm -f $G/configs/c.1/ffs.adb
    rm -f $G/configs/c.1/mass_storage.0
    rmdir $G/functions/ncm.usb0 2>/dev/null
    rmdir $G/functions/ffs.adb 2>/dev/null
    rmdir $G/functions/mass_storage.0 2>/dev/null
    umount /dev/usb-ffs/adb 2>/dev/null
    rmdir $G/configs/c.1/strings/0x409 $G/configs/c.1 2>/dev/null
    rmdir $G/strings/0x409 2>/dev/null
    rmdir $G/os_desc 2>/dev/null
    rmdir $G 2>/dev/null
    say "taken down"
}

if [ "$1" = down ]; then
    down
    exit 0
fi

# usb-gadget msc off|ro|rw : the mass-storage disk's mode on the live gadget (off takes the disk away; ro/rw set the
# read-only flag). configfs refuses to link or unlink a function on a bound configuration, so the controller is
# unbound for the change and bound again -- one re-enumeration, which is what a user plugging in a disk expects.
# usb-msc calls this around its /data unmount/remount and never asks for rw before it has unmounted /data.
if [ "$1" = msc ]; then
    [ -d "$G" ] || { say "msc: no gadget"; exit 0; }
    U=$(cat $G/UDC 2>/dev/null)
    [ -n "$U" ] && echo "" > $G/UDC 2>/dev/null
    F=$G/functions/mass_storage.0
    case "$2" in
    off)
        [ -L $G/configs/c.1/mass_storage.0 ] && rm -f $G/configs/c.1/mass_storage.0
        rmdir $F 2>/dev/null
        say "msc: the disk is taken away"
        ;;
    ro|rw)
        PART=${DISK}p4
        if [ ! -b "$PART" ]; then
            say "msc: $PART is not there"
            [ -n "$U" ] && echo "$U" > $G/UDC 2>/dev/null
            exit 1
        fi
        mkdir -p $F
        # Set the LUN's attributes BEFORE the backing file: once lun.0/file is set the kernel refuses to change ro
        # ("Device or resource busy"), so a file-first order silently leaves the disk read-write -- the one thing it
        # must never be while /data is mounted.
        echo 0 > $F/lun.0/cdrom
        echo 1 > $F/lun.0/removable
        if [ "$2" = rw ]; then echo 0 > $F/lun.0/ro; else echo 1 > $F/lun.0/ro; fi
        echo "$PART" > $F/lun.0/file
        if [ "$2" = ro ] && [ "$(cat $F/lun.0/ro 2>/dev/null)" != "1" ]; then
            say "msc: the disk would not go read-only; not exposing it"
            rmdir $F 2>/dev/null
            [ -n "$U" ] && echo "$U" > $G/UDC 2>/dev/null
            exit 1
        fi
        [ -L $G/configs/c.1/mass_storage.0 ] || ln -sf $F $G/configs/c.1/
        say "msc: $PART exposed $2"
        ;;
    *)
        echo "usage: usb-gadget msc off|ro|rw" >&2
        exit 2
        ;;
    esac
    [ -n "$U" ] && echo "$U" > $G/UDC 2>/dev/null
    exit 0
fi

UDC=$(ls /sys/class/udc 2>/dev/null | head -n 1)
if [ -z "$UDC" ]; then
    # a machine with no USB device controller (the QEMU test's virtio GPU): nothing to do, and not an error
    say "no UDC on this machine, nothing to do"
    exit 0
fi

REBUILD=1
if [ -d $G ] && [ -n "$(cat $G/UDC 2>/dev/null)" ]; then
    say "already up on $UDC"
    REBUILD=0
elif [ -d $G ] && [ -d $G/functions/ncm.usb0 ] && [ -L $G/configs/c.1/ncm.usb0 ] &&
     { [ ! -x /usr/bin/adbd ] || [ -L $G/configs/c.1/ffs.adb ]; }; then
    # the tree is complete and only the controller let go of it (a Type-C role switch took the port to host or to
    # none and back): bind it again in place. Rebuilding here (what this used to do) killed adbd and re-enumerated
    # everything, which is what made a role bounce look like a random disconnect.
    if echo "$UDC" > $G/UDC 2>/dev/null; then
        say "re-bound $UDC (the port had dropped its gadget)"
        REBUILD=0
    else
        say "could not re-bind $UDC; rebuilding"
    fi
fi
if [ "$REBUILD" = 1 ]; then
    # configfs is not mounted by anything at boot (there is no udev or systemd to do it)
    grep -q ' /sys/kernel/config ' /proc/mounts 2>/dev/null || mount -t configfs none /sys/kernel/config 2>/dev/null
    if [ ! -d /sys/kernel/config/usb_gadget ]; then
        say "no configfs, cannot make a gadget"
        exit 1
    fi
    [ -d $G ] && down          # a half-built one from an interrupted run

    mkdir -p $G
    # USB 2.0, Communications class; the Linux Foundation's vendor/product for a composite gadget
    echo 0x0200 > $G/bcdUSB
    echo 0x02   > $G/bDeviceClass
    echo 0x1d6b > $G/idVendor
    echo 0x0104 > $G/idProduct
    mkdir -p $G/strings/0x409
    echo "Banana"         > $G/strings/0x409/manufacturer
    echo "Pocket Classic" > $G/strings/0x409/product
    # a serial number is what Windows keys the network profile on; it must not be empty
    echo 0123456789ab     > $G/strings/0x409/serialnumber

    mkdir -p $G/configs/c.1/strings/0x409
    echo 0xC0 > $G/configs/c.1/bmAttributes     # self-powered
    echo 0xfe > $G/configs/c.1/MaxPower
    echo "CDC" > $G/configs/c.1/strings/0x409/configuration

    # The Microsoft OS descriptor: without it Windows asks for an RNDIS driver it has to be told to trust, and with
    # it the host picks its own NCM driver. Linux and macOS use NCM natively.
    mkdir -p $G/functions/ncm.usb0
    echo WINNCM  > $G/functions/ncm.usb0/os_desc/interface.ncm/compatible_id
    echo 1       > $G/os_desc/use
    echo 0xcd    > $G/os_desc/b_vendor_code
    echo MSFT100 > $G/os_desc/qw_sign
    # fixed, locally administered (second nibble 2) and unicast addresses, so a computer that has seen one Banana
    # keeps the same network profile for the next
    echo 82:ba:1c:92:78:02 > $G/functions/ncm.usb0/dev_addr
    echo 82:ba:1c:92:78:01 > $G/functions/ncm.usb0/host_addr

    # adb: a FunctionFS function the adbd daemon serves (see usb-adb). It shares this configuration with the network,
    # so one cable is both an Ethernet link and an adb link. The function carries no attributes of its own -- adbd
    # writes its descriptors on ep0.
    #
    # The order matters: an ffs function whose ep0 is not open yet makes the controller refuse the *whole* gadget
    # (ENODEV), taking the network down with it. So mount FunctionFS and start adbd first, and wait for the
    # function's `ready` (1 once adbd has written the adb descriptors) before binding. An image without adbd skips
    # the function entirely, so the gadget still comes up.
    ln -sf $G/functions/ncm.usb0 $G/configs/c.1/
    if [ -x /usr/bin/adbd ] && [ -x /usr/libexec/banana/usb-adb ]; then
        mkdir -p $G/functions/ffs.adb
        ln -sf $G/functions/ffs.adb $G/configs/c.1/
        mkdir -p /dev/usb-ffs/adb 2>/dev/null
        grep -q ' /dev/usb-ffs/adb ' /proc/mounts 2>/dev/null || mount -t functionfs adb /dev/usb-ffs/adb 2>/dev/null
        setsid /usr/libexec/banana/usb-adb up >/dev/null 2>&1 8>&- &
        i=0
        while [ "$(cat $G/functions/ffs.adb/ready 2>/dev/null)" != "1" ] && [ $i -lt 60 ]; do sleep 0.1; i=$((i+1)); done
    fi

    # the card's data partition as a disk, if Settings > System > Mass storage is on. Read-only at boot (see above):
    # usb-msc is what makes it read-write, after it has stopped the menu and unmounted /data. Created before the
    # controller binds, so the first enumeration already carries the disk.
    if [ "$MSC_MODE" = ro ] || [ "$MSC_MODE" = rw ]; then
        if [ -b "${DISK}p4" ]; then
            M=$G/functions/mass_storage.0
            mkdir -p $M
            # attributes before the backing file (see usb-gadget msc above): ro only takes before lun.0/file
            echo 0 > $M/lun.0/cdrom
            echo 1 > $M/lun.0/removable
            echo 1 > $M/lun.0/ro
            echo "${DISK}p4" > $M/lun.0/file
            if [ "$(cat $M/lun.0/ro 2>/dev/null)" = "1" ]; then
                ln -sf $M $G/configs/c.1/
            else
                say "mass storage: the disk would not go read-only; not exposing it"
                rmdir $M 2>/dev/null
            fi
        else
            say "mass storage is on in Settings but ${DISK}p4 is not there"
        fi
    fi

    if [ -z "$(cat $G/UDC 2>/dev/null)" ]; then
        echo "$UDC" > $G/UDC || { say "the controller would not take the gadget"; exit 1; }
    fi
    say "up on $UDC as $IFACE"
fi

# the kernel makes the interface when the function is bound, a moment after the UDC write
i=0
while [ ! -d /sys/class/net/$IFACE ] && [ $i -lt 40 ]; do sleep 0.1; i=$((i+1)); done
if [ ! -d /sys/class/net/$IFACE ]; then
    say "no $IFACE appeared (the port may be host: an OTG adapter with a device in it)"
    exit 1
fi

ip address add $ADDR/16 dev $IFACE 2>/dev/null
ip -6 address add fe80::2/64 dev $IFACE scope link 2>/dev/null
ip link set $IFACE up

# One lease, to the computer: it configures the interface itself (NetworkManager, systemd-networkd, dhclient), where a
# static address at the other end would need the user to run something on the computer.
mkdir -p /run/banana
cat > $CONF <<EOF
interface $IFACE
start $HOSTADDR
end $HOSTADDR
opt subnet 255.255.0.0
opt lease 86400
max_leases 1
lease_file /dev/null
EOF
# BusyBox's udhcpd writes no pid file, so ask the process list rather than a file that will never appear
pgrep -f /run/banana/udhcpd-usb.conf >/dev/null 2>&1 || udhcpd $CONF >/dev/null 2>&1 8>&-
say "addressed $ADDR/16, handing $HOSTADDR to the computer (ssh root@$ADDR)"
