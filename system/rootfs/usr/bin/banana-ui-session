#!/bin/sh
# The menu, with its log on the data partition (the last two runs) so a problem can be read on a computer.
# Kernel parameters (extlinux.conf's APPEND, or tools/qemu-boot.sh): banana.console=1 sends the log to the console
# (the handheld's UART, QEMU's serial) instead; banana.top=<connector> names the panel's connector (Virtual-1 in
# QEMU, the msm DSI connector on the handheld).
LOG=/data/banana/logs/banana-ui.log
mkdir -p /data/banana/logs 2>/dev/null && touch $LOG.w 2>/dev/null && rm -f $LOG.w || LOG=/run/banana/banana-ui.log
for a in $(cat /proc/cmdline); do
    case $a in
    banana.console=1) LOG=/dev/console ;;
    banana.top=*) export BANANA_TOP=${a#*=} ;;
    esac
done
[ "$LOG" != /dev/console ] && [ -f $LOG ] && mv -f $LOG $LOG.1
# The runtime dir the sound server (and cage) put their sockets in. The menu plays through PipeWire now (bananad
# points ALSA's "default" at it), and the ALSA plugin finds it only through this variable -- inittab starts this
# script, so rcS's own export is not inherited.
export XDG_RUNTIME_DIR=/run/banana/wayland
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null; chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null
# a copy of the systems list on the card replaces the built-in one
[ -f /data/banana/systems.conf ] && export BANANA_SYSTEMS=/data/banana/systems.conf
# Mass storage read-write transfer mode (Settings > System > Mass storage): /data is the computer's disk right now,
# so there is no menu to run and nothing to write. init respawns this script, so waiting here is what also keeps it
# from starting banana-ui into an unmounted /data. The flag goes away when the disk is ejected (usb-msc off).
while [ "$(cat /run/banana/usb-msc.mode 2>/dev/null)" = rw ]; do sleep 1; done
exec /usr/bin/banana-ui >> $LOG 2>&1
