{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4.1-flash",
  "instructions": [
    "docs/ARCHITECTURE.md",
    ".opencode/AGENTS.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "git": {
      "push": "ask"
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 12000
    },
    "buffer": 20000
  },
  "experimental": {
    "background_compaction": true
  }
}
