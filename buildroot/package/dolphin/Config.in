config BR2_PACKAGE_DOLPHIN
	bool "dolphin"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_PACKAGE_HAS_LIBEGL && BR2_PACKAGE_HAS_LIBGLES && BR2_PACKAGE_HAS_LIBGBM
	# the udev virtual (Dolphin's evdev backend enumerates pads through libudev); the provider is chosen in the
	# defconfig, the way every Buildroot package that needs udev does it
	depends on BR2_PACKAGE_HAS_UDEV
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_LIBEVDEV
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_VULKAN_LOADER
	select BR2_PACKAGE_WAYLAND
	select BR2_PACKAGE_WAYLAND_PROTOCOLS
	select BR2_PACKAGE_ZLIB
	help
	  Dolphin, the GameCube and Wii emulator, in its nogui frontend
	  (no Qt): a game is launched from the command line and configured
	  through the INI files beside it, which is how Banana's Wii
	  launcher drives it. It renders on the panel's GPU through EGL or
	  Vulkan, plays under cage (the Wayland kiosk compositor) so the
	  panel's orientation is applied, and takes its input from the
	  handheld's evdev gamepad.

comment "dolphin needs a libEGL/libGLES/libGBM provider and a udev provider"
	depends on !(BR2_PACKAGE_HAS_LIBEGL && BR2_PACKAGE_HAS_LIBGLES && BR2_PACKAGE_HAS_LIBGBM && BR2_PACKAGE_HAS_UDEV)
