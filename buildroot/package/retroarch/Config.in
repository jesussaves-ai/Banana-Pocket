config BR2_PACKAGE_RETROARCH
	bool "retroarch"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_PACKAGE_HAS_LIBEGL && BR2_PACKAGE_HAS_LIBGLES && BR2_PACKAGE_HAS_LIBGBM
	# the udev virtual, not a provider of it: selecting libudev-zero here closes a Kconfig cycle (retroarch ->
	# libudev-zero -> HAS_UDEV -> ti-sgx-um -> HAS_LIBEGL -> retroarch, buildroot's "recursive dependency"). The
	# provider is chosen in the defconfig, the way every buildroot package that needs udev does it. RetroArch's
	# input needs libudev's enumerate/monitor, which libudev-zero is.
	depends on BR2_PACKAGE_HAS_UDEV
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_XZ
	help
	  RetroArch, for the systems other than the DS: on one panel through KMS and GLES (no compositor), ALSA,
	  udev input (libudev-zero), and its RGUI menu, whose pixel look fits the menu's.

comment "retroarch needs a udev provider (libudev-zero)"
	depends on !BR2_PACKAGE_HAS_UDEV

if BR2_PACKAGE_RETROARCH
source "$BR2_EXTERNAL_BANANA_PATH/package/retroarch/cores.in"
endif
