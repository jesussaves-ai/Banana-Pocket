# the libretro cores, one per system in /etc/banana/systems.conf (each built and checked for aarch64)

config BR2_PACKAGE_LIBRETRO_GPSP
	bool "libretro-gpsp"
	default y
	help
	  Game Boy Advance, with its ARM64 dynamic recompiler.

config BR2_PACKAGE_LIBRETRO_MGBA
	bool "libretro-mgba"
	default y
	help
	  Game Boy Advance, accurate and with RetroAchievements support
	  (gpSP has none): chosen per system in Settings.

config BR2_PACKAGE_LIBRETRO_GAMBATTE
	bool "libretro-gambatte"
	default y
	help
	  Game Boy and Game Boy Color.

config BR2_PACKAGE_LIBRETRO_SAMEBOY
	bool "libretro-sameboy"
	default y
	help
	  Game Boy and Game Boy Color, with SameBoy: the most accurate, the
	  alternative core for the system in Settings.

config BR2_PACKAGE_LIBRETRO_FCEUMM
	bool "libretro-fceumm"
	default y
	help
	  NES and Famicom.

config BR2_PACKAGE_LIBRETRO_NESTOPIA
	bool "libretro-nestopia"
	default y
	help
	  NES and Famicom, with NEStopia: more accurate than FCEUmm, the
	  alternative core for the system in Settings.

config BR2_PACKAGE_LIBRETRO_SNES9X
	bool "libretro-snes9x"
	default y
	help
	  Super Nintendo.

config BR2_PACKAGE_LIBRETRO_BSNES
	bool "libretro-bsnes"
	default y
	help
	  Super Nintendo, with bsnes: cycle-accurate, the alternative core
	  for the system in Settings (heavier than snes9x).

config BR2_PACKAGE_LIBRETRO_PICODRIVE
	bool "libretro-picodrive"
	default y
	help
	  Mega Drive, Master System, Mega CD and 32X.

config BR2_PACKAGE_LIBRETRO_GENESIS_PLUS_GX
	bool "libretro-genesis-plus-gx"
	default y
	help
	  Mega Drive, Master System, Game Gear and Mega CD, with Genesis
	  Plus GX: more accurate than PicoDrive, the alternative core for
	  the system in Settings.

config BR2_PACKAGE_LIBRETRO_PCSX_REARMED
	bool "libretro-pcsx-rearmed"
	default y
	help
	  PlayStation, with its ARM64 dynamic recompiler (ari64) and NEON GPU.

config BR2_PACKAGE_LIBRETRO_SWANSTATION
	bool "libretro-swanstation"
	default y
	help
	  PlayStation, with SwanStation (libretro DuckStation): hardware
	  rendering and much greater accuracy than pcsx_rearmed, at a higher
	  cost. Chosen per system in Settings.

config BR2_PACKAGE_LIBRETRO_MUPEN64PLUS_NEXT
	bool "libretro-mupen64plus-next"
	default y
	help
	  Nintendo 64, with GLES3 and its ARM64 dynamic recompiler.

config BR2_PACKAGE_LIBRETRO_PARALLEL_N64
	bool "libretro-parallel-n64"
	default y
	help
	  Nintendo 64, with ParaLLEl N64: the alternative core for the
	  system in Settings (Mupen64Plus-Next is the default).

config BR2_PACKAGE_LIBRETRO_FUSE
	bool "libretro-fuse"
	default y
	help
	  ZX Spectrum, with Fuse: the 48K, the 128K and the +2/+3, plus the
	  Timex, the Pentagon and the Scorpion clones.

config BR2_PACKAGE_LIBRETRO_BEETLE_PCE_FAST
	bool "libretro-beetle-pce-fast"
	default y
	help
	  PC Engine and TurboGrafx-16 (HuCard and PC Engine CD), with
	  Beetle PCE Fast.

config BR2_PACKAGE_LIBRETRO_STELLA2014
	bool "libretro-stella2014"
	default y
	help
	  Atari 2600, with Stella 2014 (a software core, one stick and one
	  button).

config BR2_PACKAGE_LIBRETRO_VICE
	bool "libretro-vice"
	default y
	help
	  Commodore 64, with VICE (the x64 machine).

config BR2_PACKAGE_LIBRETRO_BEETLE_NGP
	bool "libretro-beetle-ngp"
	default y
	help
	  Neo Geo Pocket and Neo Geo Pocket Color, with Beetle NeoPop.

config BR2_PACKAGE_LIBRETRO_BEETLE_WSWAN
	bool "libretro-beetle-wswan"
	default y
	help
	  WonderSwan and WonderSwan Color, with Beetle WonderSwan.

config BR2_PACKAGE_LIBRETRO_HANDY
	bool "libretro-handy"
	default y
	help
	  Atari Lynx, with Handy (it needs lynxboot.img in banana/bios).

config BR2_PACKAGE_LIBRETRO_FAKE08
	bool "libretro-fake08"
	default y
	help
	  PICO-8 carts (.p8 and .p8.png), when the official PICO-8 isn't on the card.

config BR2_PACKAGE_LIBRETRO_FLYCAST
	bool "libretro-flycast"
	default y
	help
	  Sega Dreamcast (and Naomi/Atomiswave), with Flycast. A real BIOS
	  (dc_boot.bin and dc_flash.bin) goes in banana/bios on the card; without
	  one, set the core's "HLE BIOS" option (many games are unhappy on it).

config BR2_PACKAGE_RETROARCH_SLANG_SHADERS
	bool "retroarch-slang-shaders"
	default y
	help
	  libretro's Slang shader presets for RetroArch's Vulkan driver (the
	  driver Banana runs the games on, so the only presets it can load).

