# BananaOS for the Retroid Pocket Classic (SM4450 Rev Q). Build: make retroid-pocket-classic
BR2_aarch64=y
BR2_cortex_a76_a55=y
BR2_OPTIMIZE_2=y
# a handheld that runs its own games for one person: no stack protector in every function and no eager binding of
# every symbol at start (emulator cycles and start-up time); FORTIFY level 1 stays, it costs nothing
BR2_SSP_NONE=y
BR2_RELRO_PARTIAL=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_BANANA_PATH)/patches"
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
BR2_CCACHE=y
BR2_CCACHE_INITIAL_SETUP="--max-size=3G"
# BR2_DOWNLOAD_FORCE_CHECK_HASHES is not set
BR2_TARGET_GENERIC_HOSTNAME="banana"
BR2_TARGET_GENERIC_ISSUE="Banana"
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_BANANA_PATH)/board/retroid-pocket-classic/busybox.fragment"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_ENABLE_LOCALE_PURGE=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_BANANA_PATH)/../system/rootfs"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_BANANA_PATH)/board/retroid-pocket-classic/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_BANANA_PATH)/board/retroid-pocket-classic/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="retroid-pocket-classic"
# kernel: mainline Linux 7.2 with ROCKNIX's SM4450 patches (board/retroid-pocket-classic/linux-patches)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.2.tar.xz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_BANANA_PATH)/board/retroid-pocket-classic/linux-rocknix.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_BANANA_PATH)/board/retroid-pocket-classic/linux-banana.fragment $(BR2_EXTERNAL_BANANA_PATH)/board/retroid-pocket-classic/linux-qemu.fragment"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_BANANA_PATH)/board/retroid-pocket-classic/linux-patches"
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_BANANA_PATH)/board/retroid-pocket-classic/dts"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="qcom/sm4450-retroid-pocket-classic-revq"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
# no U-Boot on the RPC: OpenABL (arm-efi) loads the kernel from the EFI stub
# the root filesystem: squashfs, LZ4
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZ4=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
# firmware: the GPU (Adreno) and Venus come from linux-firmware; the Wi-Fi is the WCN3950's ath10k blobs, which ship
# with the board (firmware/ath10k/WCN3990/hw1.0, installed by post-build.sh) -- the path the qcom,wcn3990-wifi driver
# asks for. The RPC's WLAN is WCN3950/ath10k_snoc, not the RG DS's RTL8821CS. The regulatory database is its own package.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_QCOM_ADRENO=y
BR2_PACKAGE_LINUX_FIRMWARE_QCOM_VENUS=y
BR2_PACKAGE_WIRELESS_REGDB=y
# Banana
BR2_PACKAGE_BANANA_UI=y
BR2_PACKAGE_BANANAD=y
# the other systems: RetroArch and its cores (all on by default under it)
BR2_PACKAGE_RETROARCH=y
# BananaTube: the YouTube client (an app on the menu's Apps shelf). It brings mpv (with ffmpeg) for playback and
# yt-dlp for the search and for resolving a video (banana-tube passes mpv the direct stream URLs it gets).
BR2_PACKAGE_BANANA_TUBE=y
BR2_PACKAGE_MPV=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_YT_DLP=y
# The image's Lua is 5.4, for WirePlumber (the sound server's session manager, which requires Lua >= 5.3). mpv 0.40
# does not build with 5.4 (its Lua check stops at 5.2 and falls back to LuaJIT, which the image does not ship), so
# Buildroot leaves mpv's Lua off. BananaTube does not need mpv's Lua: yt-dlp resolves the stream and mpv plays it.
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y
# the udev provider the image uses (devtmpfs only, no udev daemon): RetroArch's and SDL2's input need libudev. Chosen
# here rather than selected by retroarch, which is what closed a Kconfig cycle (see package/retroarch/Config.in).
BR2_PACKAGE_LIBUDEV_ZERO=y
# what the menu, sleep and the games need
BR2_PACKAGE_ALSA_LIB=y
# UCM: the ucm2 tree (alsa-ucm-conf, with the RPC's profile in the rootfs overlay) and the alsaucm tool that reads
# it. PipeWire's ACP needs it to bring the card up itself; alsaucm validates the profile without a sound server.
BR2_PACKAGE_ALSA_LIB_UCM=y
BR2_PACKAGE_ALSA_UCM_CONF=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSAUCM=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
# aplay is the sound-test's client: it proves ALSA's "default" (the PipeWire plugin) still opens and plays
BR2_PACKAGE_ALSA_UTILS_APLAY=y
# PipeWire: a sound server, so streams mix instead of the DSP's frontends being handed over one at a time. It needs
# a session manager -- WirePlumber (GLib + Lua) -- and it discovers cards through the udev API, which libudev-zero
# supplies: two local patches are needed for this card (libudev-zero must walk /sys/class for the card, which has no
# device node, and PipeWire must not demand SOUND_INITIALIZED, a property udev's rules would add and nothing here
# runs). The RPC's UCM2 profile (above) is what ACP uses to bring the card up.
BR2_PACKAGE_PIPEWIRE=y
BR2_PACKAGE_WIREPLUMBER=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_FREEDRENO=y
# Turnip (freedreno Vulkan) and the Vulkan loader: SwanStation's Vulkan renderer runs at 5x on the a613 (see
# run-retroarch's video-driver choice). The Buildroot option itself comes from buildroot/buildroot-patches/.
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_FREEDRENO=y
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_VULKAN_TOOLS=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_SDL2=y
# cage: a kiosk Wayland compositor for the games, so the panel's turn (its "panel orientation" property, which
# wlroots reads) is applied once to everything -- RetroArch's menu, its OSD and any other app -- instead of a
# per-driver rotation patch.
BR2_PACKAGE_CAGE=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGLES=y
# SDL2 on Wayland too: the ports (PortMaster's menu and the games) run under cage, like a game under RetroArch, so
# cage turns the output with the panel's "panel orientation" -- the KMSDRM driver (kept for a card with no cage)
# renders in the panel's own portrait shape and cannot be turned.
BR2_PACKAGE_SDL2_WAYLAND=y
# SDL2's Wayland driver builds an XKB context (xkbcommon) to translate keycodes; without the XKB data files it fails
# with "Failed to create XKB context" and the app gets a black screen (PortMaster did). xkeyboard-config is that data
# (XORG7 is off: nothing else from x11r7 comes with it).
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_ZLIB=y
# libzip: Flycast (the Dreamcast core) reads its disc images through it
BR2_PACKAGE_LIBZIP=y
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_AUTOSCAN=y
BR2_PACKAGE_KSMBD_TOOLS=y
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
# adb: the handheld as an adb *device*, for a computer's `adb devices`/`adb push`/`adb shell`. adbd speaks the
# protocol over the USB adb function (FunctionFS; see usb-gadget) and, with the patch in buildroot/patches/
# android-tools, over TCP 5555 on every interface too -- so `adb connect <ip>:5555` works over Wi-Fi as well. This
# is Debian's glibc android-tools adbd, not Android's bionic one, and it needs no host key (auth is off).
BR2_PACKAGE_ANDROID_TOOLS=y
BR2_PACKAGE_ANDROID_TOOLS_ADBD=y
BR2_PACKAGE_CA_CERTIFICATES=y
# PortMaster and its ports (as ROCKNIX has them): bash for the ports' scripts, Python for PortMaster's own menu, the
# SDL2 add-ons and sound libraries ports load from the system
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PYC_ONLY=y
BR2_PACKAGE_PYTHON3_PYEXPAT=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_SQLITE=y
BR2_PACKAGE_PYTHON3_UNICODEDATA=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON3_XZ=y
BR2_PACKAGE_SDL2_TTF=y
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_SDL2_MIXER=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_OPENAL=y
BR2_PACKAGE_LIBVORBIS=y
BR2_PACKAGE_LIBTHEORA=y
BR2_PACKAGE_MPG123=y

# RetroArch-only: no PICO-8
# BR2_PACKAGE_LIBRETRO_FAKE08 is not set
